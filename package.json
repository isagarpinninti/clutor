{
  "name": "clutor",
  "version": "0.1.1",
  "private": true,
  "description": "Clutor: a terminal-first engine and toolkit for running large mixture-of-experts models from disk on small machines, with an honest memory planner, a streaming expert cache, and a sandboxed coding agent.",
  "scripts": {
    "build": "npm run build -w @clutor/core && npm run build -w @clutor/cli",
    "typecheck": "npm run typecheck -w @clutor/core -w @clutor/cli",
    "lint": "eslint .",
    "test": "npm run test -w @clutor/core -w @clutor/cli",
    "bench": "node scripts/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gates": "npm run typecheck && npm run lint && npm run engine && npm run engine:test && npm run test && npm run build && npm run bench && npm run smoke",
    "engine": "make -C c",
    "engine:test": "make -C c test"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": {
    "name": "Sagar Pinninti",
    "url": "https://github.com/isagarpinninti"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isagarpinninti/clutor.git"
  },
  "homepage": "https://github.com/isagarpinninti/clutor#readme",
  "bugs": {
    "url": "https://github.com/isagarpinninti/clutor/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "type": "module"
}
